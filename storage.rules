rules_version = '2';

// =============================================================================
// DEV-PHASE STORAGE RULES -- AUTHENTICATED (NOT admin-scoped). REVIEW BEFORE PROD.
//
// Decision (dev phase): role enforcement is OFF. Any SIGNED-IN user may upload
// RAG PDFs and media (mirrors ENFORCE_ADMIN_ROLE / enforceAdminRole). This also
// CLEARS the earlier "Storage rules use the admin claim only" caveat -- in dev,
// signed-in users can upload without the claim.
//
// Nothing here is fully public for RAG paths -- every RAG rule requires
// request.auth != null. (avatars/** stays public-read by design.)
//
// BEFORE PRODUCTION: restore the admin-claim write rules (kept in comments,
// labeled "PROD") and flip the app/Functions flags to true.
//
// Deploy:  firebase deploy --only storage
// =============================================================================
service firebase.storage {
  match /b/{bucket}/o {

    // --- Avatars: public read, owner-only write (unchanged) ---
    match /avatars/{userEmail}/{fileName=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == userEmail;
    }

    // Preview thumbnails (avatars/preview/<id>.png) -- public read, signed-in write.
    match /avatars/preview/{fileName=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- RAG media: authenticated read + write (DEV) ---
    // DEV:
    match /rag-media/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // PROD (restore): allow read: if request.auth != null;
    //                 allow write: if request.auth != null && request.auth.token.role == 'admin';

    // --- RAG source PDFs: authenticated read + write (DEV) ---
    // rag-docs/{namespace}/{docId}__{filename}.pdf
    // DEV:
    match /rag-docs/{namespace}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // PROD (restore): allow read, write: if request.auth != null && request.auth.token.role == 'admin';

    // --- Everything else: locked down by default ---
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
