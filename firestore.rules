rules_version = '2';

// =============================================================================
// DEV-PHASE RULES -- AUTHENTICATED (NOT admin-scoped). REVIEW BEFORE PRODUCTION.
//
// Decision (dev phase): role enforcement is OFF. Any SIGNED-IN user may read and
// write RAG data. This mirrors the ENFORCE_ADMIN_ROLE / enforceAdminRole flags
// in Functions + client. Nothing here is fully public -- every rule requires
// request.auth != null.
//
// BEFORE PRODUCTION: set ENFORCE_ADMIN_ROLE=true (Functions), enforceAdminRole
// =true (client environment), AND replace the DEV blocks below with the
// PRODUCTION (admin-scoped) blocks preserved in comments. The admin write rules
// are kept verbatim below each dev block, labeled "PROD".
//
// Deploy:  firebase deploy --only firestore:rules
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // Used by the PROD (commented) blocks. Admin = claim role=='admin' OR an
    // allowlist doc admins/{uid}. Kept here so restoring prod is a copy/paste.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Admin allowlist: self-read only; writes managed out-of-band ---
    // Written ONLY by the role callables via the Admin SDK (bypasses rules).
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // --- User registry (for the Role Admin list): email + lastLogin ---
    // Populated on sign-in (self-write). The `role` field is NON-authoritative
    // (a mirror); real admin status is the custom claim + admins/{uid}, both set
    // server-side. So a self-write here cannot escalate privileges.
    // DEV: signed-in read (listing) + self-write.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }
    // PROD (restore): allow read: if isAdmin(); allow write: if isSignedIn() && request.auth.uid == uid;

    // --- Per-user conversation history (text-avatar) ---
    // Rules do NOT cascade, so this explicit nested match is required. A user may
    // read/write ONLY their own conversations. Same in DEV and PROD (already
    // owner-scoped, no admin needed).
    match /users/{uid}/conversations/{conversationId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // --- Per-account query quota (users/{uid}/quota/current + .../ledger/**) ---
    // CRITICAL: the owner may READ their balance (to display remaining), but writes
    // are SERVER-ONLY (Admin SDK via the quota callables + chatRag's atomic
    // consume). A client must NEVER be able to grant itself quota. The recursive
    // {document=**} covers the current doc AND its nested ledger. DEV and PROD.
    match /users/{uid}/quota/{document=**} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // --- Assistants (avatar + RAG namespace + persona + voice + lead/tail) ---
    // PUBLIC READ: /assistants + /text-avatar are public kiosk surfaces, so the
    // client must read these configs even when signed out. They hold no secrets
    // (persona/namespace are also resolved server-side by chatRag via Admin SDK).
    // DEV write: any signed-in user.
    match /assistants/{assistantId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    // PROD (restore): allow read: if true; allow write: if isAdmin();

    // Conversational content subcollections (greetings / infoAcknowledgements /
    // farewells / suggestedPrompts). Rules do NOT cascade, so this explicit nested
    // match is required. Read by the (signed-in) Text-Avatar cache; DEV write any
    // signed-in user. The parent contentModifiedAt marker is bumped on writes.
    match /assistants/{assistantId}/{sub}/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    // PROD (restore): allow read: if isSignedIn(); allow write: if isAdmin();

    // --- Avatars (reusable visual catalog; public-read like Storage avatars) ---
    // DEV write: any signed-in user.
    match /avatars/{avatarId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    // PROD (restore): allow read: if true; allow write: if isAdmin();

    // --- LLM config (NON-SECRET: provider/model/params + key STATUS only) ---
    // The API key itself is NEVER stored here -- it lives in Secret Manager and is
    // written by the setLlmApiKey callable (Admin SDK bypasses these rules).
    // DEV: any signed-in user may read/write the non-secret config.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    // PROD (restore): allow read: if isSignedIn(); allow write: if isAdmin();

    // --- LLM config profiles (global + assistant-private; NON-SECRET metadata) ---
    // Key VALUES live in Secret Manager only. Profile docs hold provider/model/
    // params + LlmKeyRef metadata (label/secretName/active). Private-profile
    // OWNERSHIP is enforced server-side by chatRag (a private profile can't be used
    // by another assistant); these rules are the dev-permissive access layer.
    // DEV: signed-in read (for assignment dropdowns) + signed-in write.
    match /llm_profiles/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    // PROD (restore): allow read: if isSignedIn(); allow write: if isAdmin();
    // (writes also go through admin-gated callables using the Admin SDK.)

    // --- RAG namespace registry ---
    // DEV:
    match /rag_namespaces/{namespace} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    // PROD (restore): allow read: if isSignedIn(); allow write: if isAdmin();

    // --- RAG content: documents, chunks, media under rag/{namespace}/... ---
    //   rag/{namespace}/documents/{docId}, /chunks/{chunkId}, /media/{mediaId}
    // The callable + chatRag use the Admin SDK and bypass these (client surface).
    // DEV:
    match /rag/{namespace}/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    // PROD (restore): allow read: if isSignedIn(); allow write: if isAdmin();

    // --- Legacy RAG content (rag-content/{collection}/...), if still present ---
    // DEV:
    match /rag-content/{collection}/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    // PROD (restore): allow read: if isSignedIn(); allow write: if isAdmin();

    // --- Everything else: locked down by default ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
