    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "google-auth-library": "^9.14.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.4",
    "typescript": "~5.5.4"
  },
  "private": true
}
