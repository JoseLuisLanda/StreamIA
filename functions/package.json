{
  "name": "functions",
  "description": "Cloud Functions for strimearia (RAG ingestion + chatRag)",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
